// Cloudflare Worker config (DEPLOY.md). The game is static files: the Worker serves dist/ as-is, honouring dist/_headers
// (index.html never cached, releases/* cached forever). The script (worker/relay.js) runs only for paths no file matches: the multiplayer relay at /relay/...
{
  "name": "simproject",
  "main": "worker/relay.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  // One Durable Object per lobby code. SQLite-backed, which the Workers free plan allows.
  "durable_objects": {
    "bindings": [{"name": "LOBBY", "class_name": "Lobby"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Lobby"]}],
  // Public settings. GOOGLE_CLIENT_SECRET is NOT here: it is a secret (`npx wrangler secret put GOOGLE_CLIENT_SECRET`; .dev.vars for wrangler dev).
  "vars": {"GOOGLE_CLIENT_ID": "458836423148-lmq5s6ugmf2oae7esfneephf05absjpa.apps.googleusercontent.com"},
  // Accounts and cloud saves (worker/accounts.js). Schema: migrations/*.sql, applied with `npx wrangler d1 migrations apply simproject --local` (or --remote).
  "d1_databases": [{"binding": "DB", "database_name": "simproject", "database_id": "6fe7aa70-bf5b-4ba1-89d4-658c542bb62a", "migrations_dir": "migrations"}],
  // Same as the dashboard's current settings, so a deploy from this file does not switch logging off.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
