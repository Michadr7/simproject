// Cloudflare Worker config (DEPLOY.md). The game is static files: the Worker serves dist/ as-is, honouring dist/_headers
// (index.html never cached, releases/* cached forever). No script yet; the hosted multiplayer relay (Durable Objects) will be added here later.
{
  "name": "simproject",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist"
  },
  // Same as the dashboard's current settings, so a deploy from this file does not switch logging off.
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
